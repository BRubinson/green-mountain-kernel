{
  "hooks" : {
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "[ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_post_tool_use\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_post_tool_use\"",
            "type" : "command"
          }
        ],
        "matcher" : "Edit|Write|NotebookEdit|Bash"
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "[ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_pre_tool_use\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_pre_tool_use\"",
            "timeout" : 5,
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "${CLAUDE_PLUGIN_ROOT}/scripts/gm_session_startup.sh",
            "type" : "command"
          },
          {
            "command" : "_root=\"${GM_FS_ROOT:-$HOME/gmfs}\"; \\\nif [ \"$_root\" = \"$HOME/gmfs\" ]; then _app=\"${GM_APP_DEST:-/Applications}/gm_kernel.app\"; \\\n  _fix=\"bash \\\"$CLAUDE_PLUGIN_ROOT/scripts/install_gm.sh\\\"\"; \\\nelse _app=\"$_root/bin/gm_kernel.app\"; _fix=\"bash gmk/scripts/gm_env.sh create <env>\"; fi; \\\nif [ ! -d \"$_app\" ]; then \\\n  echo \"[GMB] kernel app missing at $_app — run: $_fix\" >&2; \\\nfi; exit 0",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "SubagentStart" : [
      {
        "hooks" : [
          {
            "command" : "[ -x \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_subagent_start\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/hooks/bin/gm_hook_subagent_start\"",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ]
  }
}
