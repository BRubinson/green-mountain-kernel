{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gmcc_session_startup.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check_daemon_stale.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gmcc_hook.sh subagent-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/gmcc_hook.sh post-tool-use"
          }
        ]
      }
    ]
  }
}
