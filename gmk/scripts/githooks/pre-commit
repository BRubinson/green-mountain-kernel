#!/bin/bash
#
# pre-commit — lint every staged .swift file with the repo gate before the commit lands.
# Activated per clone by: git config core.hooksPath gmk/scripts/githooks
# (rebuild_local.sh sets it when unset). Bypass once with: git commit --no-verify
#
# Lints the working-tree version of each staged file, so a partially staged file is
# judged whole.

set -u

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

FILES=()
while IFS= read -r f; do
    case "$f" in
        gmk/gmClaudeForFoundationModels/*|*/Generated/*|plugins/*|*/Package.swift) continue ;;
    esac
    [ -f "$f" ] && FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

[ ${#FILES[@]} -gt 0 ] || exit 0

if bash gmk/scripts/swift_lint_format.sh "${FILES[@]}"; then
    exit 0
fi

echo "[GMB] pre-commit: lint failed. Fix with: bash gmk/scripts/swift_lint_format.sh --fix ${FILES[*]}" >&2
echo "[GMB] pre-commit: or bypass once with: git commit --no-verify" >&2
exit 1
